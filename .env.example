# ============================================
# Admin Panel Configuration
# ============================================

# Admin password for /admin login
# IMPORTANT: Use a strong password (20+ chars, mixed case, numbers, symbols)
# Generate with: openssl rand -base64 32
ADMIN_PASSWORD=your-secure-password-here

# JWT secret for signing authentication tokens
# IMPORTANT: Use a cryptographically secure random string
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-key-here

# ============================================
# GitHub API Configuration
# ============================================

# GitHub Personal Access Token for committing pricing updates
# Create at: https://github.com/settings/tokens?type=beta
# Permissions needed: Contents (Read and Write) on this repo only
GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE

# GitHub repository details
GITHUB_OWNER=travisdbates
GITHUB_REPO=chasers-designated-drivers
GITHUB_BRANCH=main

# ============================================
# Other environment variables...
# ============================================

# ============================================
# Payment page security (see docs/CHECKOUT_SECURITY.md)
# ============================================

# AcceptBlue / MiCamp hosted tokenization
PUBLIC_ACCEPTBLUE_TOKENIZATION_KEY=your-tokenization-source-key
PUBLIC_ACCEPTBLUE_ENVIRONMENT=sandbox
# Optional: override the tokenization script URL (e.g. MiCamp white-label URL)
# PUBLIC_ACCEPTBLUE_TOKENIZATION_URL=https://tokenization.sandbox.accept.blue/tokenization/v0.3

# Checkout CSP mode: enforce (default) or report-only (temporary escape hatch only)
# CHECKOUT_CSP_MODE=enforce

# Recipients for checkout tamper/CSP alerts (defaults to ON_SIGNUP_NOTIFICATION_EMAILS)
SECURITY_ALERT_EMAILS=you@example.com
